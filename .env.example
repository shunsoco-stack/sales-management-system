# Firebase Web SDK（公開クライアント設定。Firebase Consoleで確認）
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Emulator Suiteを利用する場合だけ設定
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=

# seedスクリプト専用。実値やJSON本文はリポジトリへ保存しない
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
DEMO_SEED_PASSWORD=

# ポートフォリオ掲載URL（公開情報）
NEXT_PUBLIC_DEMO_URL=https://sales-management-system-three-sage.vercel.app/demo/
NEXT_PUBLIC_GITHUB_URL=https://github.com/shunsoco-stack/sales-management-system
